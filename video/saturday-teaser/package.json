{
  "name": "saturday-teaser",
  "version": "1.0.0",
  "description": "\uc384\ub7ec\ub370\uc774 MISSION 00 \u2014 15\ucd08 Instagram teaser",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@remotion/cli": "4.0.509",
    "@remotion/fonts": "4.0.509",
    "@remotion/media": "4.0.509",
    "@remotion/three": "4.0.509",
    "cesium": "1.146.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.509",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.509",
    "@types/react": "19.2.7",
    "@types/three": "0.185.4",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "render:reel": "remotion render SaturdayMission00-Reel output/saturday-mission-00-reel.mp4 --crf=26",
    "render:web": "remotion render SaturdayMission00-Web output/saturday-mission-00-web.mp4 --crf=23",
    "render:web-plate": "remotion render SaturdayMission00-WebPlate output/saturday-mission-00-web-plate.mp4 --crf=24",
    "render:reel-plate": "remotion render SaturdayMission00-ReelPlate output/saturday-mission-00-reel-plate.mp4 --crf=24",
    "still": "remotion still SaturdayMission00-Reel output/saturday-mission-00-poster.png --frame=390",
    "still:web": "remotion still SaturdayMission00-Web output/saturday-mission-00-web-poster.png --frame=34",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:s1": "remotion render SaturdayReel-S1 output/saturday-reel-s1.mp4 --crf=26",
    "still:story": "remotion still SaturdayStory-EndCard output/saturday-story-endcard.png",
    "sync:course": "node scripts/sync-course-assets.mjs",
    "dev:course": "npm run sync:course && remotion studio --no-open --port=3127",
    "render:course": "npm run sync:course && remotion render Sonkeechung-Reel output/sonkeechung-2026-reel-v3.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --gl=angle --concurrency=1 --timeout=120000 && node scripts/finalize-course.mjs",
    "still:course": "npm run sync:course && remotion still Sonkeechung-Cover output/sonkeechung-2026-cover-v3.png --gl=angle"
  },
  "sideEffects": [
    "*.css"
  ]
}
